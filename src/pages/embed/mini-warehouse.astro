---
// LP に iframe で埋め込むミニ倉庫（定型の流れを無限再生）。背景は透明。?bg=%23f5f5f5 で背景色を指定できる
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>箱庭！ディストリビューション — ミニ倉庫</title>
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        background: transparent;
        overflow: hidden;
      }
      canvas {
        display: block;
        width: 100%;
        height: 100%;
        touch-action: none;
      }
    </style>
  </head>
  <body>
    <canvas id="mini" aria-label="自動倉庫のデモ: 入荷した商品を搬送ロボと棚ロボが収納し、別の商品をピッカーへ運んで出荷する様子"></canvas>
    <script>
      import { startMiniWarehouse } from '../../game/embed/miniWarehouse';
      const canvas = document.getElementById('mini') as HTMLCanvasElement;
      const bg = new URLSearchParams(location.search).get('bg');
      try {
        startMiniWarehouse(canvas, { background: bg });
      } catch (e) {
        console.error(e);
      }
    </script>
  </body>
</html>
