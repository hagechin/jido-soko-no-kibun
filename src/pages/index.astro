---
// 1ページ構成。ゲーム本体は src/game/main.ts（クライアント側）で動く。
import '../styles/game.css';
import { iconMarkup } from '../game/ui/icon';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no" />
    <meta name="theme-color" content="#1d2733" />
    <meta name="build" content="__BUILD__" />
    <meta name="description" content="自動倉庫の気分 — 物流倉庫を自動化して眺めるシミュレーションゲーム" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="自動倉庫" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="icons/apple-touch-icon.png" />
    <title>自動倉庫の気分</title>
  </head>
  <body>
    <div id="app" class="app">
      <header id="hud" class="hud" aria-label="状況">
        <div class="hud-group">
          <span class="hud-item" id="hud-coins" title="コイン"><Fragment set:html={iconMarkup('coins', 16)} /> <b>0</b></span>
          <span class="hud-item rank-name" id="hud-rank" title="倉庫ランク"><Fragment set:html={iconMarkup('factory', 16)} /> <b>—</b></span>
          <span class="hud-item" id="hud-rep" title="評判"><Fragment set:html={iconMarkup('star', 16)} /> <b>0</b></span>
          <span class="hud-item" id="hud-dock" title="入荷口に滞留している個数" hidden><Fragment set:html={iconMarkup('inbox', 16)} /> <b>0</b></span>
        </div>
        <div class="hud-group">
          <span class="hud-item" id="hud-date" title="日付"><Fragment set:html={iconMarkup('calendar', 16)} /> <b>—</b></span>
          <span class="hud-item" id="hud-season"><Fragment set:html={iconMarkup('flower', 16)} /></span>
        </div>
        <div class="hud-group speed" id="speed" role="group" aria-label="速度">
          <button class="btn speed-btn" data-speed="0" aria-label="一時停止"><Fragment set:html={iconMarkup('pause', 16)} /></button>
          <button class="btn speed-btn is-active" data-speed="1">1x</button>
          <button class="btn speed-btn" data-speed="2">2x</button>
          <button class="btn speed-btn" data-speed="4">4x</button>
          <button class="btn speed-btn" id="speed-cycle" aria-label="速度を切り替え">1x</button>
        </div>
      </header>

      <aside id="orders" class="orders" aria-label="オーダー">
        <div class="orders-head"><span>オーダー</span></div>
        <span class="badge orders-queue" id="orders-queue" hidden title="待ちのオーダー">+0</span>
        <div class="orders-list" id="orders-list"></div>
      </aside>

      <main id="view" class="view">
        <canvas id="game-canvas" class="game-canvas"></canvas>
        <div class="fx-overlay" id="fx-overlay" aria-hidden="true"></div>
        <div class="view-overlay">
          <button class="btn icon-btn" id="btn-camera-reset" title="カメラをリセット" aria-label="カメラをリセット"><Fragment set:html={iconMarkup('crosshair', 18)} /></button>
        </div>
        <div class="banner" id="banner" hidden></div>
        <div class="toasts" id="toasts" aria-live="polite"></div>
        <button class="btn calm-suggest" id="calm-suggest" hidden><Fragment set:html={iconMarkup('flame', 16)} /> 眺めモードにする？</button>
        <button class="btn update-banner" id="update-banner" hidden><Fragment set:html={iconMarkup('refresh-cw', 16)} /> 更新があります（タップで再読み込み）</button>
      </main>

      <nav id="bottombar" class="bottombar" aria-label="操作">
        <div class="selected" id="selected-info"><span class="muted">ロボをタップして選択</span></div>
        <div class="bottom-actions">
          <button class="btn bar-btn" data-panel="robots"><span class="ico"><Fragment set:html={iconMarkup('bot', 18)} /></span><span class="lbl">ロボ</span></button>
          <button class="btn bar-btn" data-panel="build"><span class="ico"><Fragment set:html={iconMarkup('hammer', 18)} /></span><span class="lbl">建設</span></button>
          <button class="btn bar-btn" data-panel="upgrades"><span class="ico"><Fragment set:html={iconMarkup('trending-up', 18)} /></span><span class="lbl">強化</span></button>
          <button class="btn bar-btn" data-panel="inventory"><span class="ico"><Fragment set:html={iconMarkup('package', 18)} /></span><span class="lbl">在庫</span></button>
          <button class="btn bar-btn" data-panel="settings"><span class="ico"><Fragment set:html={iconMarkup('settings', 18)} /></span><span class="lbl">設定</span></button>
          <button class="btn bar-btn" id="btn-calm"><span class="ico"><Fragment set:html={iconMarkup('flame', 18)} /></span><span class="lbl">眺める</span></button>
        </div>
      </nav>

      <div id="sheet" class="sheet" hidden>
        <div class="sheet-head">
          <span id="sheet-title">パネル</span>
          <button class="btn icon-btn" id="sheet-close" aria-label="閉じる"><Fragment set:html={iconMarkup('x', 18)} /></button>
        </div>
        <div class="sheet-body" id="sheet-body"></div>
      </div>
      <div id="popup" class="popup" hidden></div>
      <div id="layout-editor" class="layout-editor" hidden></div>
      <div id="mini-hud" class="mini-hud"></div>
      <div id="modal" class="modal" hidden>
        <div class="modal-card" role="dialog" aria-modal="true">
          <div class="modal-head"><span id="modal-title">お知らせ</span><button class="btn icon-btn" id="modal-close" aria-label="閉じる"><Fragment set:html={iconMarkup('x', 18)} /></button></div>
          <div class="modal-body" id="modal-body"></div>
        </div>
      </div>
    </div>
    <script>
      import '../game/main.ts';
    </script>
  </body>
</html>
